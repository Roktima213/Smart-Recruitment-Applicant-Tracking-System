{
  "name": "smart-ats-backend",
  "version": "0.1.0",
  "description": "Smart Recruitment & Applicant Tracking System - Express & TypeScript Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "seed": "node ./node_modules/ts-node/dist/bin.js --project ./tsconfig.json ../database/seed/seed.ts"
  },
  "keywords": [
    "recruitment",
    "ats",
    "express",
    "typescript"
  ],
  "author": "Smart ATS Team",
  "license": "ISC",
  "dependencies": {
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "pg": "^8.23.1",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "yazl": "^3.3.1"
  }
}
