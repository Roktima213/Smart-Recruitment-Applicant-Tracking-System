# ==============================================================================
# Smart Recruitment & Applicant Tracking System (ATS)
# Environment Configuration Template (Zero Secrets Committed)
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_ats_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Firebase Auth Emulator & Admin SDK Configuration
FIREBASE_PROJECT_ID=smart-ats-dev
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Private File Storage (Resumes)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880 # 5 MB

# Email Notification Transport (SIMULATED or LIVE_SMTP)
EMAIL_MODE=SIMULATED
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
EMAIL_FROM=noreply@smartats.com

# Security & Rate Limiting
JWT_EXPIRATION_HOURS=24
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
