# Frontend Client Environment Variables
VITE_API_URL=http://localhost:5000/api

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=mock-api-key-for-emulator
VITE_FIREBASE_AUTH_DOMAIN=smart-ats-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-ats-dev
VITE_FIREBASE_STORAGE_BUCKET=smart-ats-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Local Auth Emulator Toggle (true for offline development, false for live Firebase)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
